{
  "name": "localbase",
  "version": "0.8.2",
  "description": "A Firebase-Style Database ... Offline!",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "index.d.ts",
  "files": [
    "dist",
    "localbase",
    "index.js",
    "index.d.ts",
    "README.md"
  ],
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./index.d.ts"
    }
  },
  "scripts": {
    "build": "rollup -c",
    "bundle": "npm run build",
    "bundle-dev": "rollup -c",
    "bundle-prod": "rollup -c",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "author": "Danny Connell",
  "license": "MIT",
  "dependencies": {
    "localforage": "^1.7.4"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.2",
    "fake-indexeddb": "^6.2.6",
    "rollup": "^4.65.0",
    "vitest": "^1.6.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dannyconnell/localbase.git"
  },
  "keywords": [
    "database",
    "offline",
    "firebase",
    "firestore",
    "indexeddb",
    "javascript"
  ],
  "bugs": {
    "url": "https://github.com/dannyconnell/localbase/issues"
  },
  "homepage": "https://github.com/dannyconnell/localbase#readme"
}
